# Saver 기본 서비스 설정
FRONTEND_URL=
KAKAO_SECRET=
KAKAO_KEY=
SESSION_SECRET=
HOST=

PG_HOST=
PG_PORT=
PG_USER=
PG_PASSWORD=
PG_DATABASE=

REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_PASSWORD=

RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
SEARCH_QUEUE=
SEARCH_RATE_LIMIT_MAX=10
SEARCH_RATE_LIMIT_WINDOW=60
SEARCH_EXTERNAL_PROCESSING_ENABLED=false

# 여러 공공 API adapter가 공통으로 사용할 단일 키
PUBLIC_DATA_API_KEY=
SEARCH_PROVIDER_TIMEOUT=8
SEARCH_MAX_CANDIDATES=20
SEARCH_MAX_RESULTS=10
SEARCH_USE_MOCK_PROVIDERS=false

# OpenAI-compatible API. Colab/vLLM 또는 호스팅 제공자의 URL과 키로 교체 가능
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30

# PUBLIC_DATA_API_KEY is declared above
DATA_GO_KR_SERVICE_KEY=

WELFARE_API_BASE_URL=
GOV24_API_BASE_URL=
GOV24_SERVICE_KEY=
GOV24_REQUEST_TIMEOUT_MS=

NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NAVER_SEARCH_ENDPOINT=https://openapi.naver.com/v1/search/webkr.json
NAVER_SEARCH_TIMEOUT=8

# 카카오 로그인용 KAKAO_KEY와 분리해서 사용
KAKAO_SEARCH_REST_API_KEY=
KAKAO_SEARCH_TIMEOUT=8
